{
  "name": "@facturx/core",
  "version": "1.0.0",
  "description": "Core library for Factur-X (ZUGFeRD) electronic invoicing - Full compliance with EN 16931",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:compliance": "jest --testPathPattern=compliance",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "validate": "npm run lint && npm run test",
    "prepublishOnly": "npm run validate && npm run build"
  },
  "keywords": [
    "factur-x",
    "zugferd",
    "en16931",
    "electronic-invoice",
    "e-invoicing",
    "xml",
    "pdf-a3",
    "cross-industry-invoice",
    "cii"
  ],
  "author": "SMP Solutions",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sylorion/accounting-tools",
    "directory": "lib/factur-x-ts"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "xmlbuilder2": "^3.1.1",
    "big.js": "^6.2.1"
  },
  "devDependencies": {
    "@types/big.js": "^6.2.2",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  },
  "peerDependencies": {},
  "files": [
    "dist",
    "compliance",
    "README.md",
    "LICENSE"
  ]
}
