{
  "name": "@facturx/templates",
  "version": "1.0.0",
  "description": "Professional PDF templates for Factur-X electronic invoices",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "validate": "npm run lint && npm run test",
    "prepublishOnly": "npm run validate && npm run build"
  },
  "keywords": [
    "factur-x",
    "pdf",
    "templates",
    "invoice",
    "pdf-lib",
    "professional-invoices"
  ],
  "author": "SMP Solutions",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sylorion/accounting-tools",
    "directory": "lib/smp-factur-x-ts"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@facturx/core": "file:../factur-x-ts",
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "ts-jest": "^29.1.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@facturx/core": "file:../factur-x-ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
