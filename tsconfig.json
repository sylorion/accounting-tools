{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "lib": ["ES2020", "DOM"],
    "outDir": "dist",
    "rootDir": "legacy",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["legacy/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "test",
    "**/*.test.ts",
    "legacy/example-*.ts",
    "legacy/test-*.ts",
    "legacy/FacturxEngine.ts",
    "legacy/OrderxEngine.ts",
    "legacy/OrderxXmlBuilder.ts"
  ]
}
