{
  "name": "@services/accounting",
  "version": "0.1.1",
  "description": "TypeScript library for invoice generation, compliance, and digital signing.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "tsc -p tsconfig.json && node dist/index.js",
    "dev": "ts-node legacy/index.ts",
    "invoice": "ts-node legacy/example-invoice.ts",
    "xml": "ts-node legacy/example-xml.ts",
    "xsd": "ts-node legacy/example-validation.ts",
    "loi": "ts-node legacy/example-loi.ts",
    "hbs": "ts-node legacy/example-hbs.ts",
    "order": "ts-node legacy/example-order.ts",
    "cli": "ts-node legacy/cli.ts",
    "generate:all": "ts-node --project tsconfig.generate.json -r tsconfig-paths/register examples/generate-all.ts",
    "build:libs": "cd packages/core && npm run build && cd ../templates && npm run build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:validation": "node test-validation.js",
    "check": "./check-libs.sh",
    "check:quick": "./check-libs.sh --skip-build",
    "check:strict": "./check-libs.sh --coverage-threshold=99",
    "check:libs": "cd packages/core && npm run build && npm run test:coverage",
    "setup:validation": "./scripts/setup-validation-tools.sh",
    "validate:external": "./scripts/validate-facturx.sh"
  },
  "keywords": [
    "invoice",
    "factur-x",
    "UBL",
    "digital-signature"
  ],
  "author": "YourName",
  "license": "MIT",
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@signpdf/placeholder-pdf-lib": "^3.2.4",
    "@signpdf/placeholder-plain": "^3.2.4",
    "@signpdf/signer-p12": "^3.2.4",
    "@signpdf/signpdf": "^3.2.4",
    "big": "^0.5.2",
    "big.js": "^6.2.2",
    "bigjs": "^0.0.3",
    "handlebars": "^4.7.8",
    "libxmljs": "^1.0.11",
    "lodash": "^4.17.21",
    "node-forge": "^1.3.1",
    "node-libxml": "^5.0.6",
    "node-xmllint": "^1.0.0",
    "pdf-lib": "^1.17.1",
    "puppeteer": "^24.2.1",
    "qrcode": "^1.5.4",
    "xmlbuilder2": "^3.0.2",
    "xmllint": "^0.1.1"
  },
  "devDependencies": {
    "@types/big.js": "^6.2.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.4",
    "@types/qrcode": "^1.5.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^4.9.5"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/legacy"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "legacy/**/*.ts",
      "!legacy/**/*.test.ts",
      "!legacy/example-*.ts",
      "!legacy/cli.ts"
    ]
  }
}
