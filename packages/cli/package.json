  "version": "1.0.0",
  "description": "Modern CLI for Factur-X invoice generation using production libraries",
  "main": "dist/index.js",
  "bin": {
    "facturx": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
