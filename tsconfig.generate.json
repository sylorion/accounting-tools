{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "lib": ["ES2020"],
    "outDir": "dist-generate",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@facturx/core": ["packages/core/src"],
      "@facturx/templates": ["packages/templates/src"]
    }
  },
  "include": [
    "examples/generate-all.ts",
    "examples/test-long-descriptions.ts",
    "examples/test-multipage.ts",
    "examples/test-facture-horodatee.ts",
    "examples/test-validation.ts",
    "examples/test-invoice-generation.ts",
    "legacy/test-multi-page.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
