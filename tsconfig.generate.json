{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "lib": ["ES2020"],
    "outDir": "dist-generate",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@facturx/core": ["lib/factur-x-ts/src"],
      "@facturx/templates": ["lib/smp-factur-x-ts/src"]
    }
  },
  "include": [
    "generate-all.ts",
    "test-long-descriptions.ts",
    "test-multipage.ts",
    "test-facture-horodatee.ts",
    "test-validation.ts",
    "test-invoice-generation.ts",
    "src/test-multi-page.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
